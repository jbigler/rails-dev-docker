[Unit]
Description=wt.localhost dashboard for @@P@@
Requires=@@P@@-traefik.service
After=@@P@@-traefik.service

[Container]
Image=docker.io/library/nginx:alpine
ContainerName=@@P@@-home
Network=@@P@@-proxy.network
Volume=@@ROOT@@/.docker-config/proxy/index.html:/usr/share/nginx/html/index.html:ro,z
Volume=@@ROOT@@/.docker-config/proxy/home-nginx.conf:/etc/nginx/conf.d/default.conf:ro,z
# Written by each worktree's claude container (status hook); served at /status/
# for the dashboard's claude badges.
Volume=@@ROOT@@/.docker-config/status:/usr/share/nginx/html/status:ro,z
LogDriver=k8s-file
LogOpt=max-size=20m
Label=traefik.enable=true
Label=traefik.http.routers.wt-home.rule=Host(`wt.localhost`)
Label=traefik.http.routers.wt-home.entrypoints=web
Label=traefik.http.routers.wt-home.service=wt-home
Label=traefik.http.services.wt-home.loadbalancer.server.port=80
# Same host, /api path -> Traefik's internal API (same-origin for fetch).
# No explicit priority; longer rules win automatically.
# Quoted because the value contains spaces. Quadlet writes Label= values into
# ExecStart verbatim, and systemd then splits on whitespace -- so unquoted, this
# became `--label ...rule=Host(`wt.localhost`)` plus two junk labels `&&` and
# `PathPrefix(`/api`)`. The rule silently lost its path condition, leaving
# wt-api and wt-home with the same rule and the same priority 20, so Traefik
# picked between them arbitrarily: sometimes the dashboard for `/`, sometimes
# nginx for `/api`. Quoting escapes the spaces as \x20, the way HealthCmd
# already does.
Label="traefik.http.routers.wt-api.rule=Host(`wt.localhost`) && PathPrefix(`/api`)"
Label=traefik.http.routers.wt-api.entrypoints=web
Label=traefik.http.routers.wt-api.service=api@internal

[Service]
Restart=unless-stopped

# No [Install]: pulled in by Requires= on traefik when the proxy starts.
