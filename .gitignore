# Ignore everything by default
/*

# Include repo docs
!/AGENTS.md

# Include the docker-config directory and its contents (except for the
# home-template, db-dumps and status directories)
!/.docker-config/
/.docker-config/home-template/*
/.docker-config/home-template/.*
!/.docker-config/home-template/.gitkeep


/.docker-config/db-dumps/*
!/.docker-config/db-dumps/.gitkeep
/.docker-config/status/*
!/.docker-config/status/.gitkeep

/.docker-config/claude-memory/*
!/.docker-config/claude-memory/.gitkeep

# Include the mise files
!/mise.*
!/.mise/
mise.local.toml

# Include the scripts
!/.scripts/
